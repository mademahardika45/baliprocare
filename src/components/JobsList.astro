---
import { getCollection } from 'astro:content';
import { rp } from '../config';
const jobs = (await getCollection('jobs')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { key: 'single', title: 'Single visits', sub: 'No monthly commitment' },
  { key: 'oneoff', title: 'One-off jobs', sub: 'Priced per job' },
] as const;
---
<div class="grid gap-3 lg:grid-cols-2">
  {groups.map((g, gi) => (
    <div class="card p-6 sm:p-8" data-reveal={gi}>
      <div class="flex items-baseline justify-between gap-3">
        <h3 class="text-2xl tracking-[-0.035em]">{g.title}</h3>
        <p class="text-sm text-muted">{g.sub}</p>
      </div>
      <ul class="mt-5 divide-y divide-deep/10">
        {jobs.filter((j) => j.data.group === g.key).map((j) => (
          <li class="flex items-start justify-between gap-4 py-4">
            <div>
              <p class="font-medium tracking-tight text-deep">{j.data.name}</p>
              <p class="text-sm text-muted">{j.data.detail}</p>
            </div>
            <p class="shrink-0 text-right font-medium tracking-tight whitespace-nowrap text-deep">
              {!j.data.fixed && <span class="text-xs font-normal text-muted">from </span>}{rp(j.data.from)}
              {j.data.suffix && <span class="block text-xs font-normal text-muted">{j.data.suffix}</span>}
            </p>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
<p class="mt-4 text-sm text-muted">Starting prices for a 1–2 bedroom villa. Final price depends on your property size. AC servicing and pest control through partners, quoted per job.</p>
