---
// Inline photo inside the hero headline that cycles through photos with a blur-in.
// `offset` delays the first change, so two slideshows don't switch at the same time.
import { Image } from 'astro:assets';
import { photo } from '../lib/photos';
interface Props { names: string[]; interval?: number; offset?: number; position?: string; width?: string; widthDesktop?: string }
const { names, interval = 2800, offset = 0, position = '50% 50%', width = '1.4em', widthDesktop = width } = Astro.props;
---
<span class="inline-photo hero-slides" data-interval={interval} data-offset={offset} style={`--pos:${position};--w:${width};--wd:${widthDesktop}`} aria-hidden="true">
  {names.map((n, i) => (
    <Image src={photo(n)} alt="" width={420} loading={i < 2 ? 'eager' : 'lazy'} class:list={[i === 0 && 'is-active']} />
  ))}
</span>

<style>
  .hero-slides { position: relative; width: var(--w); }
  @media (min-width: 640px) { .hero-slides { width: var(--wd); } }
  .hero-slides :global(img) {
    position: absolute; inset: 0; object-position: var(--pos);
    opacity: 0; filter: blur(14px); transform: scale(1.18);
    transition: opacity .9s ease, filter 1.1s ease, transform 1.6s cubic-bezier(.2,.8,.2,1);
  }
  .hero-slides :global(img.is-active) { opacity: 1; filter: blur(0); transform: scale(1); z-index: 1; }
  @media (prefers-reduced-motion: reduce) {
    .hero-slides :global(img) { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.hero-slides').forEach((box) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const imgs = [...box.querySelectorAll('img')];
    if (imgs.length < 2) return;
    imgs.forEach((img) => { img.loading = 'eager'; }); // warm up so transitions are smooth
    let i = 0;
    const tick = () => {
      if (document.hidden) return;
      imgs[i].classList.remove('is-active');
      i = (i + 1) % imgs.length;
      imgs[i].classList.add('is-active');
    };
    const every = Number(box.dataset.interval) || 2800;
    setTimeout(() => setInterval(tick, every), Number(box.dataset.offset) || 0);
  });
</script>
