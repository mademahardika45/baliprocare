---
// Trust blocks reused on Home, About and Packages
import Icon from './Icon.astro';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const blocks = [
  { icon: 'shield', title: 'Vetted team', text: 'ID and references checked. Trained on our visit checklists.' },
  { icon: 'key', title: 'Key and access policy', text: 'Keys are logged and stored securely. Only contract staff hold keys; freelancers are always accompanied.' },
  { icon: 'camera', title: 'Photo report', text: 'Before and after photos on WhatsApp after every visit.' },
  { icon: 'users', title: 'Backup coverage', text: 'If a team member is sick or unavailable, we send a replacement.' },
  { icon: 'doc', title: 'Service agreement', text: 'Clear written terms for every client.', tbd: 'Contoh PDF menyusul' },
];
const list = compact ? blocks.slice(0, 4) : blocks;
---
<div class:list={['grid gap-3 sm:grid-cols-2', compact ? 'lg:grid-cols-4' : 'lg:grid-cols-5']}>
  {list.map((b, i) => (
    <div class="card flex flex-col p-6" data-reveal={i}>
      <span class="grid size-11 place-items-center rounded-full bg-mist text-sea-deep"><Icon name={b.icon} /></span>
      <h3 class="mt-8 text-xl tracking-[-0.03em]">{b.title}</h3>
      <p class="mt-2 text-[15px] text-muted">{b.text}</p>
      {b.tbd && <p class="mt-3"><span class="tbd">{b.tbd}</span></p>}
    </div>
  ))}
</div>
