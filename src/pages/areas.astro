---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import AreaMap from '../components/AreaMap.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import { photo, alts } from '../lib/photos';

// Add a zone (e.g. Seminyak, Sanur, Ubud) by adding an entry to src/content/areas.json
const areas = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order);
---
<Layout
  title="Service Areas: Uluwatu & Canggu"
  description="Bali Property Care covers Uluwatu (Pecatu, Bingin, Ungasan) and Canggu (Berawa, Pererenan, Batu Bolong, Echo Beach), each with its own crew."
>
  <PageHero
    eyebrow="Service areas"
    title="Two zones."
    tone2="Each with its own crew."
    text="Uluwatu and Canggu are far apart, so each zone has a dedicated team that knows the area."
    cta="whatsapp"
    crumbs={[{ href: '/areas', label: 'Areas' }]}
  />

  <section class="wrap pb-20 md:pb-28">
    <div class="grid gap-3 lg:grid-cols-[1fr_1.25fr]">
      <AreaMap class="lg:h-full lg:min-h-[520px]" />
      <div class="grid gap-3">
        {areas.map((a, i) => (
          <article class="card grid overflow-hidden sm:grid-cols-[1fr_200px]" data-reveal={i}>
            <div class="p-6 sm:p-8">
              <span class="chip"><Icon name="pin" class="size-4" />Zone {i + 1}</span>
              <h2 class="mt-4 text-[2.2rem] leading-none tracking-[-0.045em]">{a.data.name}</h2>
              <p class="mt-3 text-body">{a.data.summary}</p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {a.data.neighbourhoods.map((n) => <li class="rounded-full bg-ice px-3 py-1.5 text-sm text-deep">{n}</li>)}
              </ul>
              <p class="mt-5 flex items-center gap-2 text-sm text-muted"><Icon name="clock" class="size-4" />{a.data.response}</p>
            </div>
            <div class="relative hidden sm:block">
              <Image src={photo(a.data.photo)} alt={alts[a.data.photo] ?? ''} widths={[300, 500]} sizes="200px" class="absolute inset-0 size-full object-cover" />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap pb-6">
    <div class="card-pastel flex flex-col gap-6 rounded-[var(--radius-card)] p-6 sm:p-10 md:flex-row md:items-center md:justify-between" data-reveal>
      <div>
        <h2 class="text-3xl tracking-[-0.04em] sm:text-4xl">Not in these areas?</h2>
        <p class="mt-2 max-w-xl text-body">Tell us where your property is and we'll let you know if we can help.</p>
      </div>
      <a href="/quote?location=other" class="btn btn-dark btn-lg shrink-0" data-track="quote_cta" data-label="other-area">Tell us your area <Icon name="arrow" class="arrow" /></a>
    </div>
  </section>

  <CtaBanner chip="Uluwatu · Canggu" title="Questions about" tone2="your area?" primary="whatsapp" image="pool-deck" />
</Layout>
